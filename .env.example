PORT=3000
JWT_SECRET=change_this_to_a_32_char_minimum_secret_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_EXPIRES_IN=10m
GEMINI_API_KEY=votre_cle_gemini
GEMINI_FALLBACK_API_KEY=votre_cle_gemini_separee_pour_le_fallback
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-1.5-flash-8b

# Providers de secours facultatifs (ordre fixe : Gemini, Gemini Flash-Lite, Groq, Cloudflare, OpenRouter)
# Plusieurs clés par provider = rotation round-robin (séparées par des virgules)
# GROQ_API_KEY=votre_cle_groq
# GROQ_API_KEYS=cle1,cle2,cle3
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=votre_cle_openrouter
# OPENROUTER_API_KEYS=cle1,cle2,cle3
# Cloudflare Workers AI - modèle avec vision, clé facultative
# CLOUDFLARE_ACCOUNT_ID=votre_compte_cloudflare
# CLOUDFLARE_API_TOKEN=votre_token_cloudflare
# CLOUDFLARE_MODEL=mistral-small-3.1-24b-instruct
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_route
SQLITE_IMPORT_PATH=./data/app.sqlite
LESSON_UPLOAD_DIR=./uploads/lessons
# Nombre maximum de questions IA par utilisateur et par jour
AI_USER_DAILY_LIMIT=40

# Exécuter `npm run db:seed-admin` après avoir renseigné ces variables
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
# ADMIN_NAME=Administrateur

# SMTP (envoi des OTP par email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre_email@example.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM=noreply@example.com